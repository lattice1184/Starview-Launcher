{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/Launcher.App/Launcher.App.csproj", "-c", "Debug"],
      "type": "process",
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/src/Launcher.Core.Tests/Launcher.Core.Tests.csproj", "-c", "Debug"],
      "type": "process",
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "publish-osx-arm64",
      "command": "dotnet",
      "args": ["publish", "${workspaceFolder}/src/Launcher.App/Launcher.App.csproj", "-c", "Release", "-r", "osx-arm64", "--self-contained", "-p:PublishSingleFile=true"],
      "type": "process",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish-osx-x64",
      "command": "dotnet",
      "args": ["publish", "${workspaceFolder}/src/Launcher.App/Launcher.App.csproj", "-c", "Release", "-r", "osx-x64", "--self-contained", "-p:PublishSingleFile=true"],
      "type": "process",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish-linux-x64",
      "command": "dotnet",
      "args": ["publish", "${workspaceFolder}/src/Launcher.App/Launcher.App.csproj", "-c", "Release", "-r", "linux-x64", "--self-contained", "-p:PublishSingleFile=true"],
      "type": "process",
      "problemMatcher": "$msCompile"
    }
  ]
}
