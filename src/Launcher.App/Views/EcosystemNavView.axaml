<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:core="using:Launcher.Core.Ecosystem"
             xmlns:app="using:Launcher.App.Converters"
             x:Class="Launcher.App.Views.EcosystemNavView"
             x:DataType="vm:EcosystemNavViewModel">

    <!-- 8-23 修复错位：原 DockPanel 按 Top-docked 内容宽保留空间，填充被挤右侧 → Grid 行布局保证全宽 -->
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="生态导航 · 精选资源站" FontSize="13" FontWeight="SemiBold" Classes="sub"/>
            <WrapPanel ItemSpacing="6">
                <Button Content="全部" Classes="ghost" FontSize="11" Padding="10,3"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="全部"
                        Classes.active="{Binding SelectedCategory, Converter={x:Static app:ValueEqualsConverter.Instance}, ConverterParameter=ALL}"/>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{Binding}" Classes="ghost" FontSize="11" Padding="10,3"
                                    Command="{Binding $parent[UserControl].((vm:EcosystemNavViewModel)DataContext).SelectCategoryCommand}"
                                    CommandParameter="{Binding}"
                                    Classes.active="{Binding $parent[UserControl].((vm:EcosystemNavViewModel)DataContext).SelectedCategory, Converter={x:Static app:ValueEqualsConverter.Instance}, ConverterParameter={Binding}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </StackPanel>

        <!-- 底部：完整目录入口（mcnav.net） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
            <TextBlock Text="想看全部 255 个站点？" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
            <Button Classes="link" FontSize="11" Content="MCNav 完整目录" Command="{Binding OpenFullCatalogCommand}"/>
        </StackPanel>

        <!-- 站点列表（竖版行式——PCL2 式一行一个，全宽行；hover 高亮 + 底部细分隔线） -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,4">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavSiteItemVM">
                        <Button HorizontalAlignment="Stretch" Margin="0,1" Padding="0" Background="Transparent"
                                BorderThickness="0" HorizontalContentAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((vm:EcosystemNavViewModel)DataContext).OpenSiteCommand}"
                                CommandParameter="{Binding Site}">
                            <Button.Styles>
                                <Style Selector="Button:hover > Border.modcard">
                                    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                    <Setter Property="BorderBrush" Value="#3C4757"/>
                                </Style>
                                <Style Selector="Button:pressed > Border.modcard">
                                    <Setter Property="Background" Value="{DynamicResource BgActive}"/>
                                </Style>
                            </Button.Styles>
                            <Border Classes="modcard" Background="Transparent"
                                    Padding="12,9" BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="0,0,0,1">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                    </Transitions>
                                </Border.Transitions>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <!-- favicon（失败降级首字母块） -->
                                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True"
                                                Background="{DynamicResource BgActive}" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform"/>
                                        </Border>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentDark}"
                                                IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}">
                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="15"
                                                       Foreground="{DynamicResource AccentLight}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Site.Name}" FontWeight="SemiBold" Foreground="White"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="3" Padding="5,1" Background="{DynamicResource AccentDark}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Site.Category}" FontSize="10"
                                                           Foreground="{DynamicResource AccentLight}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Host}" Foreground="{DynamicResource TextDim}"
                                                       FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Site.Description}" Foreground="{StaticResource TextLog}"
                                                   FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="打开 ↗" Foreground="{DynamicResource TextDim}"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
