<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:app="using:Launcher.App.Converters"
             xmlns:behaviors="using:Launcher.App.Animations"
             x:Class="Launcher.App.Views.EcosystemView"
             x:DataType="vm:EcosystemViewModel">

    <DockPanel>
        <!-- 顶部：搜索 + 实例 + 三级筛选 + 状态（类型 tab 由外层下载板块控制） -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <!-- 8-27 布局修复：实例下拉内容溢出压 ▼ 箭头（Name 无 MaxWidth/Trimming）→ 改 DisplayName + 裁剪 + MaxWidth
                 （对齐 HomeView 实例下拉）；搜索框 MinWidth 防被 Auto 实例下拉挤没 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding Query}" Watermark="搜索…" MinWidth="220"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                          PlaceholderText="目标实例" MinWidth="190" MaxWidth="240"
                          HorizontalContentAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VersionInstanceVM">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                           ToolTip.Tip="{Binding DisplayName}"/>
                                <Border CornerRadius="3" Padding="5,0" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentDark}" IsVisible="{Binding LoaderBadge, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{Binding LoaderBadge}" FontSize="9" Foreground="{DynamicResource AccentLight}"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- 筛选行 1：加载器 chips（仅 MOD）；8-27 改 WrapPanel——窄窗可换行不横向溢出 -->
            <WrapPanel Orientation="Horizontal" ItemSpacing="4" IsVisible="{Binding IsModType}">
                <Button Content="全部" Classes="ghost" FontSize="11" Padding="10,3"
                        Command="{Binding SelectLoaderCommand}" CommandParameter="全部"
                        Classes.active="{Binding SelectedLoader, Converter={x:Static app:ValueEqualsConverter.Instance}, ConverterParameter=ALL}"/>
                <Button Content="Fabric" Classes="ghost" FontSize="11" Padding="10,3"
                        Command="{Binding SelectLoaderCommand}" CommandParameter="Fabric"
                        Classes.active="{Binding SelectedLoader, Converter={x:Static app:ValueEqualsConverter.Instance}, ConverterParameter=Fabric}"/>
                <Button Content="Forge" Classes="ghost" FontSize="11" Padding="10,3"
                        Command="{Binding SelectLoaderCommand}" CommandParameter="Forge"
                        Classes.active="{Binding SelectedLoader, Converter={x:Static app:ValueEqualsConverter.Instance}, ConverterParameter=Forge}"/>
                <Button Content="NeoForge" Classes="ghost" FontSize="11" Padding="10,3"
                        Command="{Binding SelectLoaderCommand}" CommandParameter="NeoForge"
                        Classes.active="{Binding SelectedLoader, Converter={x:Static app:ValueEqualsConverter.Instance}, ConverterParameter=NeoForge}"/>
                <Button Content="Quilt" Classes="ghost" FontSize="11" Padding="10,3"
                        Command="{Binding SelectLoaderCommand}" CommandParameter="Quilt"
                        Classes.active="{Binding SelectedLoader, Converter={x:Static app:ValueEqualsConverter.Instance}, ConverterParameter=Quilt}"/>
            </WrapPanel>

            <!-- 筛选行 2：版本/分类/排序/来源 Grid 均分（宽窗口无右侧空白）+ 收藏右对齐 -->
            <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="10">
                <ComboBox Grid.Column="0" ItemsSource="{Binding GameVersionOptions}"
                          SelectedItem="{Binding SelectedGameVersion}" MinWidth="110">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:EcosystemViewModel+GameVersionOption">
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:EcosystemViewModel.CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory}" MinWidth="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:EcosystemViewModel+CategoryOption">
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:EcosystemViewModel.SortOptions}"
                          SelectedItem="{Binding SelectedSort}" MinWidth="110">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:EcosystemViewModel+SortOption">
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="3" ItemsSource="{Binding SourceOptions}"
                          SelectedItem="{Binding SelectedSource}" MinWidth="100">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:EcosystemViewModel+SourceOption">
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="4" Content="★ 收藏" Classes="ghost" FontSize="11" Padding="10,3"
                        Classes.active="{Binding FavoritesOnly}"
                        Command="{Binding ToggleFavoritesCommand}"/>
            </Grid>

            <TextBlock Text="{Binding Status}" Foreground="#8A93A6" FontSize="12"/>
        </StackPanel>

        <!-- 内容：列表层与详情层叠放 -->
        <Grid>
            <!-- 列表层（DockPanel：ScrollViewer 受约束才能滚动） -->
            <DockPanel IsVisible="{Binding !IsDetailOpen}">
                <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}"/>
                <StackPanel DockPanel.Dock="Top" Spacing="8" IsVisible="{Binding IsError}">
                    <SelectableTextBlock Text="{Binding ErrorMessage}" Foreground="#E05A5A" TextWrapping="Wrap"/>
                    <Button Content="重试" Command="{Binding SearchCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="没找到你要的内容" Foreground="#8A93A6" HorizontalAlignment="Center"
                           Margin="0,40" IsVisible="{Binding IsEmpty}"/>
                <!-- 8-14 CF 无 key 平替：官网手动下载入口（PCL 式「去网页下」） -->
                <Button DockPanel.Dock="Top" Content="前往 CurseForge 官网手动下载" Classes="ghost" FontSize="12"
                        HorizontalAlignment="Center" Margin="0,0,0,8"
                        Command="{Binding OpenManualBrowseCommand}"
                        IsVisible="{Binding ManualBrowseUrl, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <!-- 分页栏（◀ 页码 ▶） -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="◀" Classes="ghost" Padding="10,4" FontSize="12"
                            Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrev}"/>
                    <TextBlock Text="{Binding PageText}" Classes="sub" FontSize="12"
                               VerticalAlignment="Center" MinWidth="36" TextAlignment="Center"/>
                    <Button Content="▶" Classes="ghost" Padding="10,4" FontSize="12"
                            Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNext}"/>
                </StackPanel>

                <ScrollViewer x:Name="CardsScroll">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <!-- 竖排列表（PCL2 式：一行一个项目，全宽行） -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectCardVM">
                                <Button HorizontalAlignment="Stretch" Margin="0,1" Padding="0" Background="Transparent"
                                        BorderThickness="0" HorizontalContentAlignment="Stretch"
                                        behaviors:SpringScaleBehavior.Enabled="False"
                                        behaviors:HoverBrushBehavior.Enabled="False"
                                        behaviors:RippleBehavior.Enabled="False"
                                        Command="{Binding $parent[UserControl].((vm:EcosystemViewModel)DataContext).OpenDetailCommand}"
                                        CommandParameter="{Binding}">
                                    <!-- 8-25 卡片 hover 残留根治：禁用全局 Button 三个行为（缩放/hover 变色/涟漪）+
                                         去掉 hover/pressed 背景变（静态卡，无悬浮无残留）。
                                         8-25 布局改下拉列表式：紧凑两行（标题行 + 描述/统计内联），
                                         安装收进「安装 ▾」下拉菜单（左键弹菜单：安装到当前实例 / 收藏）——
                                         去掉右列统计竖排 + 大号 primary 按钮（分散 + 色调不匹配） -->
                                    <!-- 8-25 hover 根因修复：modcard 删内联 Background——局部值压过样式 Setter，hover 背景从未生效。
                                         基态走默认透明，hover 由 Button:hover Border.modcard 样式驱动 BgRaised -->
                                    <Border Classes="modcard"
                                            Padding="10,7" BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="0,0,0,1">
                                        <Border.Transitions>
                                            <Transitions>
                                                <!-- 8-26 悬浮跟手：0.15s 过渡划过列表时高亮慢半拍（不跟手），缩到 0.06s -->
                                                <BrushTransition Property="Background" Duration="0:0:0.06"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusLarge}"
                                                    ClipToBounds="True" Background="{DynamicResource BgActive}"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White"
                                                               MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                    <Border CornerRadius="3" Padding="5,1" Background="{DynamicResource AccentDark}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SourceText}" FontSize="10" Foreground="{DynamicResource AccentLight}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                                </StackPanel>
                                                <!-- 描述 + 统计内联一行（描述 * 列截断，统计靠右） -->
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextLog}" FontSize="12"
                                                               MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource TextDim}" FontSize="11">
                                                        <Run Text="{Binding DownloadsText}"/><Run Text=" 下载"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Foreground="{DynamicResource TextDim}" FontSize="11"
                                                               IsVisible="{Binding ShowFollows}">
                                                        <Run Text="{Binding FollowsText}"/><Run Text=" 关注"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="3" Text="{Binding UpdatedText}" Foreground="{DynamicResource TextDim}" FontSize="10"/>
                                                </Grid>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="ghost" FontSize="12" Padding="10,5"
                                                    VerticalAlignment="Center" Margin="0,0,2,0"
                                                    Click="OnInstallMenuClick">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <!-- 8-25 修：ContextMenu 是独立 Popup 视觉树，$parent[UserControl] 解析失败 →
                                                             安装走 code-behind（OnInstallMenuItemClick 取卡片 + 父 VM 直调命令） -->
                                                        <MenuItem Header="安装到当前实例" Click="OnInstallMenuItemClick"/>
                                                        <MenuItem Header="{Binding StarText}" Command="{Binding ToggleFavoriteCommand}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="安装"/>
                                                    <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- 详情层 -->
            <ContentControl Content="{Binding Detail}" IsVisible="{Binding IsDetailOpen}"/>
        </Grid>
    </DockPanel>
</UserControl>
