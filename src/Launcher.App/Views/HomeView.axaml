<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:svc="using:Launcher.App.Services"
             xmlns:app="using:Launcher.App.Converters"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Launcher.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="10">

        <!-- ① 启动控制卡（顶部一行高密度操作 + 阶段条） -->
        <Border Classes="card" Padding="12">
            <StackPanel Spacing="8">
                <!-- 8-26 行1精简：头像（账号入口）+ 版本 + 启动/停止 + 状态——删玩家名板，名字看头像 ToolTip -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                    <!-- 8-31 账号入口直白化：头像 + 名字 + 账号类型 + 管理提示，整块可点（原裸头像找不到入口） -->
                    <Button x:Name="AvatarButton" Padding="0" Background="Transparent" BorderThickness="0"
                            Click="OnAvatarClick" ToolTip.Tip="点击管理账号">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="44" Height="44" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgRaised}">
                                <!-- 8-13：头像加载期间首字母占位，不露白 -->
                                <Grid>
                                    <Image Source="{Binding PlayerAvatar}" Width="44" Height="44" Stretch="Uniform"
                                           Loaded="OnAvatarImageLoaded"
                                           IsVisible="{Binding PlayerAvatar, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                                    <TextBlock Text="{Binding PlayerAvatarFallback}" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding PlayerAvatar, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1" MaxWidth="120">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding PlayerName}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource Accent}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AccountTypeText}" Classes="dim" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <!-- 8-31 版本横向条（PCL 式）：所有已装版本一排横排，点选高亮（选中项自动同步全局）；
                         8-30 沙盒下拉并排，选择即存（严格隔离断网会挡联机，tooltip 已提示） -->
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedVersion}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 VerticalAlignment="Center">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VersionInstanceVM">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                               ToolTip.Tip="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <!-- 版本条 item 专属：圆角 chip，命中区大；选中 = accent 高亮（不再是小到看不清的下拉高亮） -->
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="14,7"/>
                                    <Setter Property="Background" Value="{DynamicResource BgRaised}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                            <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{DynamicResource AccentDark}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentLight}"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:HomeViewModel.SandboxOptions}"
                                  SelectedItem="{Binding SelectedSandboxOption}"
                                  MinWidth="104" VerticalAlignment="Center"
                                  ToolTip.Tip="沙盒启动：严格隔离 = 断网 + 只准读写游戏文件夹。Windows 端断网需管理员权限；断网会挡住游戏内联机">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SandboxOption">
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Button Grid.Column="2" Content="启动游戏" Classes="primary" Padding="26,9" FontSize="13"
                            Command="{Binding LaunchCommand}" VerticalAlignment="Center"
                            IsEnabled="{Binding CanLaunch}"
                            IsVisible="{Binding !IsRunning}"
                            ToolTip.Tip="{Binding LaunchButtonTip}"/>
                    <Button Grid.Column="2" Content="强制关闭" Padding="26,9" FontSize="13"
                            Command="{Binding StopGameCommand}" VerticalAlignment="Center"
                            IsVisible="{Binding IsRunning}"
                            ToolTip.Tip="直接结束游戏进程（含子进程），不二次确认"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinWidth="84">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StateColor}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LaunchState}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>

                <!-- 行2：阶段指示条 + 状态文字 + 跳过检查按钮（仅启动时显示，平时保持卡矮小） -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,8,0,0"
                      IsVisible="{Binding IsLaunching}">
                    <ItemsControl ItemsSource="{Binding Stages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LaunchStageVM">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Classes.stagedot="True" Classes.current="{Binding IsCurrent}"
                                            Width="8" Height="8" CornerRadius="4"
                                            Background="{Binding DotColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="1" Text="{Binding LaunchStatus}" Classes="sub" FontSize="11"
                               VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                    <!-- 8-28 预检可跳过：大型整合包交给用户决定，随时取消扫描直接启动 -->
                    <Button Grid.Column="2" Content="跳过模组检查" Classes="ghost" FontSize="11" Padding="10,4"
                            Command="{Binding SkipPreCheckCommand}" IsVisible="{Binding IsPreCheckRunning}"/>
                </Grid>

                <!-- 8-26 删配置摘要小字（进设置页查看）；阶段条+状态已表达进度，删底部进度条 -->
                <!-- 启动失败修复入口（客户端文件缺失时显示） -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowRepairGuide}">
                    <TextBlock Text="{Binding RepairGuideText}" Foreground="{StaticResource Danger}" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="去版本页补全" Classes="primary" FontSize="11" Padding="14,5"
                                Command="{Binding GoRepairCommand}"/>
                        <Button Content="打开官方下载页" Classes="link"
                                Command="{Binding OpenOfficialDownloadCommand}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ② 日志卡（全宽；Tab 双视图：控制台 / 启动记录）。
             8-19 半透明化：日志卡实色与 72% 透明内容区反差大（透明度高时观感"变深割裂"），
             改 80%/90% 半透明跟随窗口透明度。
             8-25 再透一档：文字渲染已响应式适配透明档（毛玻璃不糊），日志卡降到 64%/85%。
             8-25 控制台偏深 → 换淡色石板灰（BgHover）当底 + 近白文字，淡而不糊、对比清楚 -->
        <Border Classes="card" Grid.Row="1" Padding="0" Background="#CC2C3544">
            <DockPanel>
                <!-- 头部 Tab -->
                <Border DockPanel.Dock="Top" Background="#D9242A36" Padding="12,8"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Button Content="控制台" Classes="tab" Classes.active="{Binding IsConsoleTabSelected}"
                            FontSize="12" Padding="12,5" Command="{Binding SwitchLogTabCommand}" CommandParameter="console"/>
                    <Button Grid.Column="1" Classes="tab" Classes.active="{Binding IsHistoryTabSelected}"
                            FontSize="12" Padding="12,5" Command="{Binding SwitchLogTabCommand}" CommandParameter="history">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="启动记录"/>
                            <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="5,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding HistoryCount}" Foreground="{DynamicResource Accent}" FontSize="10"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Content="复制日志" Classes="ghost" FontSize="11" Padding="10,3"
                            Click="OnCopyLogs" IsVisible="{Binding IsConsoleTabSelected}"/>
                    <Button Grid.Column="4" Content="导出日志" Classes="ghost" FontSize="11" Padding="10,3"
                            Click="OnExportLogs" IsVisible="{Binding IsConsoleTabSelected}"/>
                    <Button Grid.Column="4" Content="清除记录" Classes="danger" FontSize="11" Padding="10,3"
                            Command="{Binding ClearLaunchHistoryCommand}" IsVisible="{Binding IsHistoryTabSelected}"/>
                </Grid>
                </Border>

                <!-- 8-26 主体：同格叠放两面板（可见者后声明收点击）；平时折叠（启动中/看历史时展开） -->
                <Grid IsVisible="{Binding LogBodyVisible}">
                    <!-- 启动记录面板 -->
                    <ScrollViewer IsVisible="{Binding IsHistoryTabSelected}">
                        <StackPanel Spacing="4" Margin="12,10">
                            <TextBlock Text="你还没启动过游戏" Classes="dim" FontSize="12" HorizontalAlignment="Center"
                                       Margin="0,40,0,0" IsVisible="{Binding !HasHistory}"/>
                            <ItemsControl ItemsSource="{Binding LaunchHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="svc:LaunchHistoryEntry">
                                        <Grid ColumnDefinitions="Auto,88,*,Auto,Auto" ColumnSpacing="8" Margin="0,2" MinHeight="22">
                                            <TextBlock Text="{Binding TimeText}" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding VersionId}" FontSize="11" LineHeight="16"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Error}" FontSize="11"
                                                       Foreground="{StaticResource Danger}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="3" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                    Background="{DynamicResource SuccessBg}">
                                                <TextBlock Text="{Binding OutcomeText}" FontSize="10" Foreground="#5AD07C"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- 8-18 查看日志：启动记录关联当次日志文件（无日志文件的旧记录不显示） -->
                                            <Button Grid.Column="4" Padding="6,1" CornerRadius="3" FontSize="10"
                                                    IsVisible="{Binding LogPath, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                    Click="OnOpenLaunchLog" Tag="{Binding LogPath}" Cursor="Hand"
                                                    ToolTip.Tip="打开这次启动的日志文件">
                                                <TextBlock Text="日志" FontSize="10" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 控制台面板（后声明=选中时在最上层） -->
                    <Grid IsVisible="{Binding IsConsoleTabSelected}">
                        <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GameLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LogLine">
                                        <!-- 8-26 报错区域标记：ERROR/WARN/FATAL/异常标红、启动器事件§强调青 -->
                                        <SelectableTextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{Binding Kind, Converter={x:Static app:LogLineBrushConverter.Instance}}"
                                                   TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- 空状态 -->
                        <StackPanel IsVisible="{Binding !HasLogs}" Spacing="6" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="控制台还没动静" Classes="sub" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="你选好版本点「启动游戏」。日志会实时显示在这" Classes="dim" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ③ 账号面板（头像点击弹出：当前账号 / 已保存列表 / 登录） -->
        <Popup x:Name="AccountPopup" Placement="Bottom" PlacementTarget="{Binding #AvatarButton}"
               IsLightDismissEnabled="True"
               Opened="OnAccountPopupOpened">
            <Border x:Name="AccountPanel" Classes="card" Padding="14" Width="400">
                <StackPanel Spacing="12">
                    <!-- 当前账号行 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Width="48" Height="48" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgRaised}">
                            <Grid>
                                <Image Source="{Binding Account.Avatar}" Width="48" Height="48" Stretch="Uniform"
                                       IsVisible="{Binding Account.Avatar, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                                <TextBlock Text="{Binding Account.AvatarFallback}" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding Account.Avatar, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Account.CurrentName}" FontSize="16" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Account.AccountType}" Classes="dim" FontSize="12"
                                           IsVisible="{Binding Account.IsLoggedIn}"/>
                                <!-- 8-13 正版账号管理：跳官网改皮肤/披风/用户名（Mojang 不开放 API） -->
                                <Button Content="正版账号管理" Classes="link" FontSize="11" Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding Account.OpenMojangProfileCommand}"
                                        IsVisible="{Binding Account.IsMicrosoftAccount}"
                                        ToolTip.Tip="皮肤、披风、用户名在 Minecraft 官网修改"/>
                                <!-- 8-31 离线改名：自动 Player 允许改成自己的名字（正版/LittleSkin 不改——平台身份） -->
                                <Button Content="改名" Classes="link" FontSize="11" Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding Account.StartRenameOfflineCommand}"
                                        IsVisible="{Binding Account.IsOfflineAccount}"
                                        ToolTip.Tip="改成你自己的名字（离线身份，UUID 由名字派生）"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Content="退出" Classes="ghost" FontSize="12" Padding="10,5"
                                VerticalAlignment="Center" Command="{Binding Account.LogoutCommand}"
                                IsVisible="{Binding Account.IsLoggedIn}"/>
                    </Grid>

                    <!-- 8-31 离线改名内联行：点「改名」展开，输入新名 + 确认/取消 -->
                    <StackPanel Spacing="8" IsVisible="{Binding Account.IsRenamingOffline}">
                        <TextBox Text="{Binding Account.RenameInput}" PlaceholderText="新名字（最长 16 字符，不能有空格）" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="确认改名" Classes="primary" FontSize="12" Padding="14,5"
                                    Command="{Binding Account.CommitRenameOfflineCommand}"/>
                            <Button Content="取消" Classes="ghost" FontSize="12" Padding="14,5"
                                    Command="{Binding Account.CancelRenameOfflineCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 已保存账号列表（切换/删除） -->
                    <Border CornerRadius="6" Background="{DynamicResource BgBase}" Padding="8"
                            IsVisible="{Binding Account.Accounts.Count}">
                        <ItemsControl ItemsSource="{Binding Account.Accounts}" MaxHeight="160">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountRowVM">
                                    <!-- 8-19 整行可点切换（删除按钮区除外）；Cursor 提示可点 -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,3"
                                          PointerPressed="OnRowPointerPressed" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <Border CornerRadius="3" Padding="5,1" Background="{DynamicResource AccentDark}"
                                                    VerticalAlignment="Center" IsVisible="{Binding IsCurrent}">
                                                <TextBlock Text="当前" FontSize="9" Foreground="{DynamicResource AccentLight}"/>
                                            </Border>
                                            <TextBlock Text="{Binding TypeText}" Classes="dim" FontSize="11"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="切换" Classes="ghost" FontSize="11" Padding="10,4"
                                                Click="OnSwitchAccount" CommandParameter="{Binding}"
                                                IsVisible="{Binding !IsCurrent}"/>
                                        <Button Grid.Column="2" Content="删除" Classes="danger" FontSize="11" Padding="10,4"
                                                Click="OnDeleteAccount" CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 8-13 登录方式分割（PCL 式）：有账号时表单收起，点「添加账号」展开/收起（常显可点） -->
                    <Button Content="+ 添加账号" Classes="ghost" FontSize="12" Padding="12,8"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding Account.ToggleLoginFormCommand}"
                            IsVisible="{Binding Account.IsLoggedIn}"/>

                    <StackPanel Spacing="10" IsVisible="{Binding Account.IsLoginFormVisible}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="正版登录" Classes="tab" Classes.active="{Binding Account.IsMicrosoftMode}"
                                    FontSize="12" Padding="14,6" Command="{Binding Account.SetLoginModeCommand}"
                                    CommandParameter="microsoft"/>
                            <Button Content="离线登录" Classes="tab" Classes.active="{Binding Account.IsOfflineMode}"
                                    FontSize="12" Padding="14,6" Command="{Binding Account.SetLoginModeCommand}"
                                    CommandParameter="offline"/>
                            <Button Content="Littleskin" Classes="tab" Classes.active="{Binding Account.IsLittleskinMode}"
                                    FontSize="12" Padding="14,6" Command="{Binding Account.SetLoginModeCommand}"
                                    CommandParameter="littleskin"/>
                        </StackPanel>

                        <!-- 正版（设备码流） -->
                        <Button Content="发起正版登录" Classes="primary" FontSize="12" Padding="14,7"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding Account.LoginMicrosoftCommand}"
                                IsEnabled="{Binding !Account.IsMsAuthBusy}"
                                IsVisible="{Binding Account.IsMicrosoftMode}"/>

                        <!-- 离线 -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Account.IsOfflineMode}">
                            <TextBox Grid.Column="0" Text="{Binding Account.NameInput}" Watermark="用户名" FontSize="13"/>
                            <Button Grid.Column="1" Content="离线登录" Classes="primary" FontSize="12" Padding="14,6"
                                    Command="{Binding Account.LoginOfflineCommand}"/>
                        </Grid>

                        <!-- Littleskin 第三方（8-19 重设计：一次授权搞定，不用填任何东西） -->
                        <StackPanel Spacing="8" IsVisible="{Binding Account.IsLittleskinMode}">
                            <TextBlock Text="点一下登录：浏览器授权一次，账号和皮肤库一起连接好，之后皮肤库直接进"
                                       Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                            <Button Content="Littleskin 登录" Classes="primary" FontSize="12" Padding="14,7"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding Account.LoginLittleskinCommand}"
                                    IsEnabled="{Binding !Account.IsMsAuthBusy}"
                                    ToolTip.Tip="首次需要浏览器输配对码授权；之后打开皮肤库直接可用，不用再配对"/>
                            <Button Content="注册 Littleskin" Classes="link" FontSize="11" Padding="0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding Account.OpenLittleskinRegisterCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 8-13 设备码登录：配对码大字显示 + 复制 + 重开网页 + 取消 -->
                    <StackPanel Spacing="6" IsVisible="{Binding Account.IsDeviceCodeMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border CornerRadius="6" Padding="14,6" Background="{DynamicResource AccentDark}">
                                <TextBlock Text="{Binding Account.DeviceCodeText}" FontSize="24" FontWeight="Bold"
                                           FontFamily="Consolas" Foreground="{DynamicResource AccentLight}"/>
                            </Border>
                            <Button Content="复制代码" Classes="ghost" FontSize="11" Padding="10,6"
                                    VerticalAlignment="Center" Click="OnCopyDeviceCode"/>
                        </StackPanel>
                        <TextBlock Text="在打开的网页里输入上面的代码并登录。登录完成后这里会自动继续"
                                   Classes="dim" FontSize="10" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="重新打开登录网页" Classes="link" FontSize="11" Padding="10,4"
                                    Command="{Binding Account.ReopenLoginPageCommand}"/>
                            <Button Content="取消登录" Classes="ghost" FontSize="11" Padding="10,4"
                                    Command="{Binding Account.CancelMsLoginCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- 8-19 皮肤库常显（登录后表单收起也有入口——LittleSkin 衣柜浏览/应用皮肤） -->
                        <Button Content="皮肤库" Classes="ghost" FontSize="11" Padding="8,3"
                                HorizontalAlignment="Left" Click="OnOpenSkinLibrary"
                                ToolTip.Tip="内置 LittleSkin 皮肤库：连接账号浏览衣柜，一键应用皮肤（游戏内立即生效）"/>
                        <Button Content="更换皮肤…" Classes="ghost" FontSize="11" Padding="8,3"
                                HorizontalAlignment="Left" Click="OnPickSkin"/>
                        <Button Content="重置皮肤" Classes="ghost" FontSize="11" Padding="8,3"
                                HorizontalAlignment="Left" Click="OnResetSkin"
                                ToolTip.Tip="正版账号恢复 Mojang 官方皮肤；离线/Littleskin 随机 Steve/Alex 默认皮肤"/>
                    </StackPanel>

                    <!-- 正版授权进度 / 操作状态 -->
                    <Border CornerRadius="6" Padding="8,6" Background="{DynamicResource AccentDark}" IsVisible="{Binding Account.IsMsAuthBusy}">
                        <TextBlock Text="{Binding Account.MsAuthStatus}" FontSize="11" Foreground="{DynamicResource AccentLight}"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="{Binding Account.Status}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
