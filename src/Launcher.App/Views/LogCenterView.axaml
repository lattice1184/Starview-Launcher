<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             x:Class="Launcher.App.Views.LogCenterView"
             x:DataType="vm:LogCenterViewModel">

    <!-- 8-26 日志中心从0重做：平铺列表 + 分类 tab + 内容区（弃 TreeView——单击选中/展开时序打架是反复出问题源头）。
         窗口内覆盖层（MainWindow.LogCenterHost 挂载），主窗不失活 → 不触发亚克力降级 -->
    <Border Classes="surface" CornerRadius="12" BorderBrush="#4D2F3745" BorderThickness="1" Padding="18">
        <DockPanel>
            <!-- 顶：分类 tab + 关闭 -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="下载" Classes="tab" Padding="14,6" Classes.active="{Binding IsDownloadTab}"
                            Command="{Binding SelectCategoryCommand}" CommandParameter="下载"/>
                    <Button Content="启动" Classes="tab" Padding="14,6" Classes.active="{Binding IsLaunchTab}"
                            Command="{Binding SelectCategoryCommand}" CommandParameter="启动"/>
                    <Button Content="修复" Classes="tab" Padding="14,6" Classes.active="{Binding IsRepairTab}"
                            Command="{Binding SelectCategoryCommand}" CommandParameter="修复"/>
                    <Button Content="刷新" Classes="ghost" Padding="10,4" Margin="10,0,0,0" FontSize="11"
                            Command="{Binding ReloadCommand}" ToolTip.Tip="重新扫描日志目录"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕ 关闭" Classes="ghost" Padding="10,4" FontSize="11"
                        HorizontalAlignment="Right" x:Name="CloseBtn"/>
            </Grid>

            <!-- 底：当前选中摘要 + 打开文件 -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,10,0,0">
                <TextBlock Text="{Binding SummaryText}" Classes="dim" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="打开文件" Classes="ghost" Padding="12,5" FontSize="11"
                        Command="{Binding OpenFileCommand}" ToolTip.Tip="用系统记事本打开原文"/>
            </Grid>

            <!-- 中：左列表 + 右内容 -->
            <Grid ColumnDefinitions="260,*" ColumnSpacing="14">
                <Border Classes="surface" CornerRadius="8" Padding="4">
                    <ListBox x:Name="EntriesList" ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogEntry">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="2,1">
                                    <TextBlock Text="📄" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" Classes="dim" FontSize="10"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border Grid.Column="1" Classes="surface" CornerRadius="8" Padding="12">
                    <ScrollViewer>
                        <SelectableTextBlock Text="{Binding Content}" FontFamily="Consolas, Microsoft YaHei UI"
                                             FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                             Foreground="{DynamicResource TextSecondary}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
