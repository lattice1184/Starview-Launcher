<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.App.ViewModels"
        xmlns:svc="using:Launcher.App.Services"
        xmlns:behaviors="using:Launcher.App.Animations"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Launcher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/starview.ico"
        Title="Starview"
        WindowStartupLocation="CenterScreen" SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur,Blur,None"
        Background="Transparent"
        TransparencyBackgroundFallback="#FF12161F">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- 根：液态玻璃层（splash 阶段隐藏）与透明 splash 层同层叠放 -->
    <Grid>
    <!-- 液态玻璃背景层（毛玻璃：滚动内容透过可见模糊） -->
    <Border x:Name="WindowRoot" CornerRadius="12" BorderBrush="#4D2F3745" BorderThickness="1" ClipToBounds="True">
        <ExperimentalAcrylicBorder x:Name="RootSurface" CornerRadius="12">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                             TintColor="#12161F"
                                             TintOpacity="0.30"
                                             FallbackColor="#FF12161F"/>
            </ExperimentalAcrylicBorder.Material>
            <Grid>
            <!-- 8-13 批次 34 终局：无启动动画——内容与背景随窗口直接全量显示 -->
            <DockPanel x:Name="AppContent">
                <!-- 左侧导航（液态玻璃，整列一种色、全高；空白处可拖拽窗口，双击最大化） -->
                <ExperimentalAcrylicBorder x:Name="NavSurface" DockPanel.Dock="Left" Width="160" CornerRadius="0"
                                           PointerPressed="TitleBar_PointerPressed">
                    <ExperimentalAcrylicBorder.Material>
                        <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                                     TintColor="#12161F"
                                                     TintOpacity="0.88"/><!-- 8-18：白色壁纸下 0.55 透 45% 壁纸 → 导航栏「花了」；提到 0.92 接近实色，保可读性。8-16 批次 50：调淡至 0.88 略透，玻璃感更自然。8-23：透明档沿用 Digger（材质只有 None/Digger，Digger 即毛玻璃）；实色档运行期切 None+不透明 -->
                    </ExperimentalAcrylicBorder.Material>
                    <Grid>
                        <!-- 激活指示条：独立滑动元素（位置由 ApplyNavVisuals 动画控制），替代按钮左侧描边 -->
                        <Border x:Name="NavIndicator" Width="3" CornerRadius="2" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <StackPanel Margin="10">
                        <!-- 8-21 品牌区：望星图标 + 名字（图标 22px 融入导航栏）。
                             8-22 移除入场动画（误加，网页已有独立 splash；品牌区直接静态显示防启动卡顿观感） -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,8,6,18">
                            <Image Source="avares://Launcher.App/Assets/logo.png" Width="22" Height="22"
                                   Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Starview" FontSize="15" FontWeight="SemiBold" Foreground="#E8EAF0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- 导航项视觉（hover/active/按下）由 MainWindow.axaml.cs 本地值驱动——样式伪类在 Avalonia 12 下不可靠（历史多轮修复失败） -->
                        <Button x:Name="NavHome"
                                Command="{Binding NavigateCommand}" CommandParameter="home"
                                behaviors:SpringScaleBehavior.Enabled="False"
                                behaviors:HoverBrushBehavior.Enabled="False"
                                behaviors:RippleBehavior.Enabled="False"
                                PointerEntered="NavEnter" PointerExited="NavExit"
                                PointerPressed="NavPress" PointerReleased="NavRelease"
                                HorizontalAlignment="Stretch" Margin="0,2" Padding="12,7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid x:Name="NavHomeHost" Width="28" Height="28" VerticalAlignment="Center">
                                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.3,0,0.3"><!-- 8-18 重心补偿：房子主体偏下 0.56vb → 上移 0.3px -->
                                    <Path x:Name="NavHomeIconR" Data="{StaticResource NavIconHomeRegular}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}"/>
                                    <Path x:Name="NavHomeIconF" Data="{StaticResource NavIconHomeFilled}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}" Opacity="0"/>
                                </Grid>
                                </Grid>
                                <TextBlock Text="主页" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavVersions"
                                Command="{Binding NavigateCommand}" CommandParameter="version"
                                behaviors:SpringScaleBehavior.Enabled="False"
                                behaviors:HoverBrushBehavior.Enabled="False"
                                behaviors:RippleBehavior.Enabled="False"
                                PointerEntered="NavEnter" PointerExited="NavExit"
                                PointerPressed="NavPress" PointerReleased="NavRelease"
                                HorizontalAlignment="Stretch" Margin="0,2" Padding="12,7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid x:Name="NavVersionHost" Width="28" Height="28" VerticalAlignment="Center">
                                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="NavVersionIconR" Data="{StaticResource NavIconVersionRegular}" Stretch="Uniform"
                                          Fill="Transparent" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"/>
                                    <Path x:Name="NavVersionIconF" Data="{StaticResource NavIconVersionFilled}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}" Opacity="0"/>
                                </Grid>
                                </Grid>
                                <TextBlock Text="版本" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDownloads"
                                Command="{Binding NavigateCommand}" CommandParameter="download"
                                behaviors:SpringScaleBehavior.Enabled="False"
                                behaviors:HoverBrushBehavior.Enabled="False"
                                behaviors:RippleBehavior.Enabled="False"
                                PointerEntered="NavEnter" PointerExited="NavExit"
                                PointerPressed="NavPress" PointerReleased="NavRelease"
                                HorizontalAlignment="Stretch" Margin="0,2" Padding="12,7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid x:Name="NavDownloadHost" Width="28" Height="28" VerticalAlignment="Center">
                                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.9,0,0.9"><!-- 8-18 重心补偿：箭头偏下 1.58vb → 上移 0.9px -->
                                    <Path x:Name="NavDownloadIconR" Data="{StaticResource NavIconDownloadRegular}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}"/>
                                    <Path x:Name="NavDownloadIconF" Data="{StaticResource NavIconDownloadFilled}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}" Opacity="0"/>
                                </Grid>
                                </Grid>
                                <TextBlock Text="下载" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                                <Border Classes="badge" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="5,0"
                                        VerticalAlignment="Center" IsVisible="{Binding Downloads.HasActive}">
                                    <TextBlock Text="{Binding Downloads.ActiveBadgeText}" Foreground="{DynamicResource Accent}" FontSize="10"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavMultiplayer"
                                Command="{Binding NavigateCommand}" CommandParameter="multiplayer"
                                behaviors:SpringScaleBehavior.Enabled="False"
                                behaviors:HoverBrushBehavior.Enabled="False"
                                behaviors:RippleBehavior.Enabled="False"
                                PointerEntered="NavEnter" PointerExited="NavExit"
                                PointerPressed="NavPress" PointerReleased="NavRelease"
                                HorizontalAlignment="Stretch" Margin="0,2" Padding="12,7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid x:Name="NavMultiHost" Width="28" Height="28" VerticalAlignment="Center">
                                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0.6,0,-0.6"><!-- 8-18 重心补偿：人形偏上 0.95vb → 下移 0.6px -->
                                    <Path x:Name="NavMultiIconR" Data="{StaticResource NavIconMultiRegular}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}"/>
                                    <Path x:Name="NavMultiIconF" Data="{StaticResource NavIconMultiFilled}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}" Opacity="0"/>
                                    <!-- 8-18 联机=两人用虚线连接（点击时虚线流动动画由 NavMultiDash 驱动） -->
                                    <Path x:Name="NavMultiDash" Data="M 8 14.5 L 16 14.5" Stretch="Uniform"
                                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2"
                                          StrokeDashArray="1.6,2" StrokeDashOffset="0" IsHitTestVisible="False"/>
                                </Grid>
                                </Grid>
                                <TextBlock Text="联机" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavEcosystem"
                                Command="{Binding NavigateCommand}" CommandParameter="ecosystem"
                                behaviors:SpringScaleBehavior.Enabled="False"
                                behaviors:HoverBrushBehavior.Enabled="False"
                                behaviors:RippleBehavior.Enabled="False"
                                PointerEntered="NavEnter" PointerExited="NavExit"
                                PointerPressed="NavPress" PointerReleased="NavRelease"
                                HorizontalAlignment="Stretch" Margin="0,2" Padding="12,7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid x:Name="NavEcoHost" Width="28" Height="28" VerticalAlignment="Center">
                                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0.3,0,-0.3"><!-- 8-18 重心补偿：地球偏上 0.59vb → 下移 0.3px -->
                                    <Path x:Name="NavEcoIconR" Data="{StaticResource NavIconEcoRegular}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}"/>
                                    <Path x:Name="NavEcoIconF" Data="{StaticResource NavIconEcoFilled}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}" Opacity="0"/>
                                </Grid>
                                </Grid>
                                <TextBlock Text="生态" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings"
                                Command="{Binding NavigateCommand}" CommandParameter="settings"
                                behaviors:SpringScaleBehavior.Enabled="False"
                                behaviors:HoverBrushBehavior.Enabled="False"
                                behaviors:RippleBehavior.Enabled="False"
                                PointerEntered="NavEnter" PointerExited="NavExit"
                                PointerPressed="NavPress" PointerReleased="NavRelease"
                                HorizontalAlignment="Stretch" Margin="0,2" Padding="12,7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid x:Name="NavSettingsHost" Width="28" Height="28" VerticalAlignment="Center">
                                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0.2,0,-0.2"><!-- 8-18 重心补偿：齿轮偏上 0.37vb → 下移 0.2px -->
                                    <Path x:Name="NavSettingsIconR" Data="{StaticResource NavIconSettingsRegular}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}"/>
                                    <Path x:Name="NavSettingsIconF" Data="{StaticResource NavIconSettingsFilled}" Stretch="Uniform"
                                          Fill="{Binding $parent[Button].Foreground}" Opacity="0"/>
                                </Grid>
                                </Grid>
                                <TextBlock Text="设置" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </Grid>
                </ExperimentalAcrylicBorder>

                <!-- 右侧内容区（页面切换动画；密度缩放；背板 72% 半透明——玻璃透出）。
                     顶部标题条与内容同色：左导航一色、右内容一色，顶部不再有第三条颜色 -->
                <Border x:Name="ContentSurface" Background="{DynamicResource BackgroundColor}">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Grid>
                        <!-- 自定义背景：图片层（ApplyBackgroundImage 设置画刷）+ 65% 黑压暗（保文字可读）。
                             页面根无背景 → 图片透出；Border.card/glass-card 实色保持不透明 -->
                        <Border x:Name="BgDim" Background="#A6000000" IsVisible="False" IsHitTestVisible="False"/>
                        <DockPanel>
                        <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="36" Background="{DynamicResource BackgroundColor}"
                                PointerPressed="TitleBar_PointerPressed">
                            <!-- 窗口按钮：纯 Border+字形、手动 hover 变色，绝无缩放/位移/模板行为（错位根治）。
                                 只做最小化+关闭（去掉最大化）；双击标题条空白处可最大化/还原 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border x:Name="BtnMin" Width="44" Height="36" Background="Transparent"
                                        PointerEntered="TitleBtn_PointerEntered" PointerExited="TitleBtn_PointerExited"
                                        PointerPressed="TitleBtn_PointerPressed" PointerReleased="TitleBtn_PointerReleased">
                                    <TextBlock x:Name="BtnMinGlyph" Text="─" FontSize="12" Foreground="#8A93A6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Border>
                                <Border x:Name="BtnClose" Width="44" Height="36" Background="Transparent"
                                        PointerEntered="TitleBtn_PointerEntered" PointerExited="TitleBtn_PointerExited"
                                        PointerPressed="TitleBtn_PointerPressed" PointerReleased="TitleBtn_PointerReleased">
                                    <TextBlock x:Name="BtnCloseGlyph" Text="✕" FontSize="12" Foreground="#8A93A6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Padding="12">
                            <TransitioningContentControl x:Name="PageHost" Content="{Binding CurrentPage}"/>
                        </Border>
                        </DockPanel>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Toast 覆盖层（右上角堆叠；不拦截点击；容器 realize 时右侧滑入） -->
            <ItemsControl x:Name="ToastsHost" ItemsSource="{Binding Source={x:Static svc:NotificationService.Toasts}}"
                          IsHitTestVisible="False"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,10,14,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:ToastItem">
                        <!-- 8-16 点击复制错误信息（Cursor 手型 + ToolTip 提示） -->
                        <Border Background="#F2242A36" BorderBrush="{Binding Border}" BorderThickness="1"
                                CornerRadius="10" Padding="14,9" Opacity="{Binding Opacity}"
                                PointerPressed="OnToastCopy" Cursor="Hand" IsHitTestVisible="True"
                                ToolTip.Tip="点击复制这段文字">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.24"/>
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayMessage}" Foreground="{Binding MessageBrush}"
                                           FontSize="12" TextWrapping="Wrap" MaxWidth="360"/>
                                <Button Content="{Binding ActionText}" Classes="ghost" FontSize="10" Padding="8,2"
                                        IsVisible="{Binding HasAction}" Click="OnToastAction"
                                        ToolTip.Tip="点击打开对应内容"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 8-24 模态确认覆盖层：主窗口内渲染，不再开第二个顶层窗口（避免主窗口失活 → 亚克力合成降级回调实色） -->
            <Grid x:Name="DialogHost" IsVisible="False" Background="#66000000" ZIndex="200">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                    </Transitions>
                </Grid.Transitions>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource BgSurface}" CornerRadius="12"
                        BorderBrush="#4D2F3745" BorderThickness="1"
                        MinWidth="360" MaxWidth="480" Padding="26,22">
                    <ContentControl x:Name="DialogContent"/>
                </Border>
            </Grid>

            <!-- 8-26 日志中心覆盖层：窗口内渲染（主窗不失活 → 亚克力不降级），全尺寸面板（比小弹窗大） -->
            <Grid x:Name="LogCenterHost" IsVisible="False" Background="#A6000000" ZIndex="300">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    </Transitions>
                </Grid.Transitions>
                <Border Margin="64,56" Background="{DynamicResource BgSurface}" CornerRadius="12"
                        BorderBrush="#4D2F3745" BorderThickness="1">
                    <ContentControl x:Name="LogCenterContent"/>
                </Border>
            </Grid>

            </Grid>
        </ExperimentalAcrylicBorder>
    </Border>
    </Grid>
</Window>
