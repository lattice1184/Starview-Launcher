<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:cu="using:Launcher.Core.Utils"
             x:Class="Launcher.App.Views.SectionAboutView"
             x:DataType="vm:SettingsViewModel">

    <!-- 关于 / 卸载（善后：删除启动器本体 + 应用数据 + 游戏目录，不留一个东西） -->
    <Border Classes="setting-group">
        <StackPanel Spacing="10">
            <TextBlock Text="关于" Classes="group-header"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- 8-21 关于页大图标（望星正式图标） -->
                <Image Source="avares://Launcher.App/Assets/logo.png" Width="56" Height="56"
                       Stretch="Uniform" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Starview" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AppVersion}" Classes="dim" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="此启动器为 1 学生 + 1 AI 开发" Classes="dim" FontSize="11"/>
            <TextBlock Text="基于 Avalonia / .NET 10，core 库基于 PCL Community（Apache-2.0）" Classes="dim" FontSize="11"/>

            <!-- 8-30 后台静默更新：自动检查开关 + 手动检查 + 就绪后重启安装 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <TextBlock Text="自动检查更新" Classes="setting-label" VerticalAlignment="Center"/>
                <ToggleSwitch IsChecked="{Binding AutoCheckUpdate}"/>
                <Border Classes="help-hint"
                           ToolTip.Tip="启动后后台检查 GitHub 最新版，有新版下载好后提示重启生效"
                           VerticalAlignment="Center"><Path/></Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="检查更新" Classes="ghost" Padding="14,6"
                        Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding !IsCheckingUpdate}"/>
                <Button Content="重启安装" Classes="primary" Padding="14,6"
                        Command="{Binding InstallUpdateCommand}" IsVisible="{Binding IsUpdateReady}"/>
                <TextBlock Text="{Binding UpdateStatusText}" Classes="dim" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="管理空间" Classes="ghost" Padding="14,6" Click="OnOpenStorage"/>
                <Button Content="仓库主页 ↗" Classes="link" Padding="14,6" Click="OnOpenGitHub"
                        ToolTip.Tip="GitHub 仓库（源码/更新/发布）"/>
                <Button Content="反馈 ↗" Classes="link" Padding="14,6" Click="OnOpenIssues"
                        ToolTip.Tip="提 issue：问题、建议都行，中文英文都可以"/>
                <Button Content="卸载启动器" Classes="danger" Padding="14,6" Click="OnUninstall"/>
                <Border Classes="help-hint"
                           ToolTip.Tip="删启动器本体、设置账号日志和游戏目录，含世界存档，找不回来。点完还会再确认一次"><Path/></Border>
            </StackPanel>
            <TextBlock Text="删除后无法恢复" Classes="status-error" FontSize="11"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="启动时随机小提示" Classes="setting-label" VerticalAlignment="Center"/>
                <ToggleSwitch IsChecked="{Binding StartupTipEnabled}"/>
                <Border Classes="help-hint"
                           ToolTip.Tip="启动游戏时随机弹一条彩蛋。改了下次启动生效"
                           VerticalAlignment="Center"><Path/></Border>
            </StackPanel>

            <!-- 最近更新：默认最近 5 条，展开看完整日志 -->
            <TextBlock Text="最近更新" Classes="setting-label" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding ChangelogItemsRecent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 8-31 完整日志改版本分组展示（v1.1.9 / v1.1.8 / … / 更早版本） -->
            <Expander Header="完整更新日志" FontSize="12">
                <ItemsControl ItemsSource="{Binding ChangelogGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="cu:ChangelogCatalog+ChangelogGroup">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,1"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <!-- 鸣谢 -->
            <TextBlock Text="鸣谢" Classes="setting-label" Margin="0,8,0,0"/>
            <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                       Text="特别感谢 PCL Community：核心库 PCL.Core（Apache-2.0）是启动器的基石，本项目的下载与整合包等大量功能建立在其之上。"/>

            <!-- 赞助者：用户的资金支持——启动器能走到今天，离不开他们 -->
            <TextBlock Text="赞助者" Classes="setting-label" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding Sponsors}" Margin="0,2,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#16FFFFFF" CornerRadius="10" Padding="10,3" Margin="0,0,6,4">
                            <TextBlock Text="{Binding}" Classes="dim" FontSize="11"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                       Text="这几位朋友的真金白银支撑着启动器一路走到今天，真心感谢每一位 ❤"/>
            <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="也离不开我的家人，和一些不方便展示信息隐私的朋友。"/>

            <!-- 开源声明 / 第三方依赖 -->
            <TextBlock Text="开源声明" Classes="setting-label" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding ProjectNotices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander Header="第三方依赖清单" FontSize="12">
                <ItemsControl ItemsSource="{Binding ThirdPartyPackages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" Classes="dim" TextWrapping="Wrap">
                                <Run Text="{Binding Name}"/><Run Text=" · "/><Run Text="{Binding Version}"/><Run Text=" · "/><Run Text="{Binding License}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
