<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             x:Class="Launcher.App.Views.SectionGameDirView"
             x:DataType="vm:SettingsViewModel">

    <!-- 游戏目录 -->
    <Border Classes="setting-group">
        <StackPanel Spacing="10">
            <TextBlock Text="游戏目录" Classes="group-header"/>
            <TextBlock Text="启动器装游戏、存存档和模组的地方。可以换到别的盘（点「浏览…」），或指到一个已有的 .minecraft 文件夹直接接着用——那个文件夹里的版本会显示在列表里。版本隔离开着时，每个版本单独一个文件夹，存档模组互不干扰。"
                       Classes="dim" FontSize="11" TextWrapping="Wrap"/>
            <Grid Classes="setting-row" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding GameDirectoryText}" IsReadOnly="True"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="打开文件夹" Classes="ghost" Cursor="Hand" Command="{Binding OpenGameDirectoryCommand}"/>
                    <Button Content="浏览…" Classes="ghost" Click="OnBrowseGameDir"/>
                    <Button Content="默认" Classes="ghost" Click="OnResetGameDir"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SourceLabelText}" Classes="dim" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="版本隔离" Classes="setting-label"
                           VerticalAlignment="Center"/>
                <ToggleSwitch IsChecked="{Binding VersionIsolation}"/>
                <Border Classes="help-hint"
                           ToolTip.Tip="你开着时每个版本独立文件夹，存档模组不混。关了全挤在一起"
                           VerticalAlignment="Center"><Path/></Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
