<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             x:Class="Launcher.App.Views.SectionLaunchView"
             x:DataType="vm:SettingsViewModel">

    <!-- 启动 -->
    <Border Classes="setting-group">
        <StackPanel Spacing="10">
            <TextBlock Text="启动" Classes="group-header"/>
            <TextBlock Text="这里管游戏怎么跑：分多少内存、用哪个 Java、进程优先级和额外参数。一般不用动——内存按机器实际大小选（16GB 机器开 6~8GB 比较稳），Java 找不到或想换版本时在这里手动指定路径。"
                       Classes="dim" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock Text="内存与 Java" Classes="group-sub"/>

            <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="内存分配" Classes="setting-label" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding MemoryPresets}"
                          SelectedItem="{Binding SelectedMemoryPreset}" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemoryPresetVM">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding IsCustomMemory}">
                    <TextBox x:Name="MemoryCustomText" Width="90" Text="{Binding MemoryCustomText}"
                             KeyDown="OnMemoryCustomKeyDown" LostFocus="OnMemoryCustomLostFocus"/>
                    <TextBlock Text="MB" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="Java 路径" Classes="setting-label" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding JavaPathText}" Watermark="自动选配"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="浏览…" Classes="ghost" Click="OnBrowseJava"/>
                    <Button Content="自动" Classes="ghost" Click="OnResetJava"/>
                </StackPanel>
            </Grid>

            <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="进程优先级" Classes="setting-label" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding GamePriorityOptions}"
                          SelectedItem="{Binding SelectedGamePriority}" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GamePriorityOption">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Path Grid.Column="2" Classes="help-hint"
                           ToolTip.Tip="游戏按这个跑。调高游戏更顺，其他程序可能卡。调低适合挂着。改完下次启动才生效。"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Classes="setting-row" ColumnDefinitions="Auto,*">
                <TextBlock Text="额外 JVM 参数" Classes="setting-label" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding ExtraJvmArgsText}"
                         Watermark="-Dxxx=1 -Xss2m"/>
            </Grid>

            <TextBlock Text="性能" Classes="group-sub"/>
            <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="性能档位" Classes="setting-label" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding JvmProfileOptions}"
                          SelectedItem="{Binding SelectedJvmProfile}" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:JvmProfileOption">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Path Grid.Column="2" Classes="help-hint"
                           ToolTip.Tip="四档 GC 预设，只管内存回收不管内存大小，下次启动生效。轻量：停顿目标 ≤200ms；均衡：≤100ms；流畅：≤50ms 并开启并行引用处理（适合大内存）；极致：≤50ms 并开启字符串去重（追求最低卡顿，内存开销略大）"
                           VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="启动时自动把游戏设为中文" Classes="setting-label" VerticalAlignment="Center"/>
                <ToggleSwitch IsChecked="{Binding AutoChineseEnabled}"/>
            </StackPanel>
            <!-- 8-13：微软登录 Client ID 设置项已移除——登录有远程下发/缓存/内置三层兜底，无需用户填写 -->
        </StackPanel>
    </Border>
</UserControl>
