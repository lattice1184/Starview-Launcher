<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:core="using:Launcher.Core.Server"
             x:Class="Launcher.App.Views.ServerView"
             x:DataType="vm:ServerViewModel">

    <!-- 8-23 修复错位：原 DockPanel 按 Top-docked 内容宽保留空间，填充被挤右侧 → Grid 行布局保证全宽 -->
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 8-25 取消开服独立窗口（连根扒）：新窗口触发主窗合成降级实色，且 ServerWindow 已无用——开服只在页内展示 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
            <TextBlock Text="开服" FontSize="18" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="sub" FontSize="12"
                       Classes.status-error="{Binding StatusIsError}"
                       VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- 操作条：版本选择 + 下载/启动 单行（不再堆叠卡片） -->
        <Border Grid.Row="1" Classes="card" Padding="12" Margin="0,0,0,10">
            <StackPanel Spacing="6">
                <WrapPanel ItemSpacing="8">
                    <ComboBox MinWidth="220" ItemsSource="{Binding InstalledVersions}"
                              SelectedItem="{Binding SelectedVersion}"
                              PlaceholderText="选择已安装版本">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VersionInstanceVM">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="开服" Classes="primary" Padding="20,8"
                            Command="{Binding OneClickStartCommand}" IsVisible="{Binding !IsRunning}"/>
                    <Button Content="刷新" Classes="ghost" Padding="12,8"
                            Command="{Binding RefreshVersionsCommand}"/>
                    <Button Content="下载服务端" Classes="ghost" Padding="16,8"
                            Command="{Binding DownloadServerCommand}" IsEnabled="{Binding !IsInstalling}"/>
                    <Button Content="启动" Classes="ghost" Padding="24,8"
                            Command="{Binding StartServerCommand}" IsVisible="{Binding !IsRunning}"/>
                    <Button Content="停止" Padding="24,8"
                            Command="{Binding StopServerCommand}" IsVisible="{Binding IsRunning}"/>
                    <Button Content="进入服务器" Classes="ghost" Padding="16,8"
                            Command="{Binding JoinGameCommand}" IsEnabled="{Binding IsRunning}"/>
                    <Button Content="生成世界" Classes="ghost" Padding="16,8"
                            Command="{Binding GenerateWorldCommand}" IsVisible="{Binding !IsRunning}"/>
                </WrapPanel>
                <TextBlock Text="{Binding ServerDirText}" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- 下两栏：左参数 / 右控制台（GridSplitter 为 Grid 直接子级，修复 R 批次嵌套 bug） -->
        <Grid Grid.Row="2" ColumnDefinitions="2*,1,3*">
            <ScrollViewer Grid.Column="0" MinWidth="240">
                <StackPanel Spacing="8">

                    <!-- 机器状态（实时）+ 建议配置（直接可改） -->
                    <Border Classes="card" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="机器状态 · 每 5 秒自动刷新" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MachineStatusText}" Classes="sub" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="20"/>

                            <!-- 连接信息（服务端运行中显示：本机一键进服 + 局域网复制给朋友） -->
                            <Border CornerRadius="6" Padding="10,8" Background="#22332F3F"
                                    IsVisible="{Binding IsRunning}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="连接信息" FontSize="12" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="本机" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LocalAddressText}" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="局域网" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LanAddressText}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="复制" Classes="ghost" FontSize="11" Padding="10,2"
                                                Command="{Binding CopyLanAddressCommand}"
                                                IsVisible="{Binding LanAddressText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </Grid>
                                    <!-- 8-15 对外地址（蓝盾/虚拟局域网）：填了复制按钮优先复制它 -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="对外" Classes="dim" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="朋友在蓝盾/虚拟局域网里时填蓝盾分配的 IP（如 10.x.x.x）；只填 IP 会自动拼服务端端口"/>
                                        <TextBox Grid.Column="1" Text="{Binding ExternalAddressText}" FontSize="12"
                                                 Watermark="蓝盾/虚拟网 IP（留空用局域网）"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 管理员（OP）：运行中随时授予，无需玩家在线，上线即生效 -->
                            <Border CornerRadius="6" Padding="10,8" Background="#22332F3F"
                                    IsVisible="{Binding IsRunning}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="管理员（OP）" FontSize="12" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Grid.Column="0" Text="{Binding OpNameText, Mode=TwoWay}"
                                                 Watermark="玩家名（默认当前登录账号）" FontSize="12"/>
                                        <Button Grid.Column="1" Content="授予 OP" Classes="primary" FontSize="12"
                                                Padding="14,6" Command="{Binding GrantOpCommand}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding OpStatusText}" Classes="dim" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 建议配置编辑（不用跳设置页） -->
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="建议配置（可直接修改后应用）" FontSize="12" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="内存 (MB)" Classes="sub" FontSize="12" VerticalAlignment="Center" MinWidth="64"/>
                                    <TextBox Grid.Column="1" Text="{Binding SuggestionMemoryText}" FontSize="12"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="视距" Classes="sub" FontSize="12" VerticalAlignment="Center" MinWidth="64"/>
                                    <TextBox Grid.Column="1" Text="{Binding SuggestionViewText}" FontSize="12"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="最大玩家" Classes="sub" FontSize="12" VerticalAlignment="Center" MinWidth="64"/>
                                    <TextBox Grid.Column="1" Text="{Binding SuggestionPlayersText}" FontSize="12"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="测试低配" Classes="ghost" FontSize="12" Padding="12,5"
                                            Click="OnPresetClick" CommandParameter="0" ToolTip.Tip="内存 1G · 视距 4 · 玩家 5。适合老机器测试"/>
                                    <Button Content="推荐（按机器）" Classes="ghost" FontSize="12" Padding="12,5"
                                            Click="OnPresetClick" CommandParameter="1" ToolTip.Tip="按你机器当前的 CPU 核数和可用内存算"/>
                                    <Button Content="高配" Classes="ghost" FontSize="12" Padding="12,5"
                                            Click="OnPresetClick" CommandParameter="2" ToolTip.Tip="内存 8G · 视距 16 · 玩家 40"/>
                                </StackPanel>
                                <Button Content="应用建议配置" Classes="primary" FontSize="12" Padding="14,6"
                                        HorizontalAlignment="Left" Command="{Binding ApplySuggestionCommand}"/>
                                <TextBlock Text="{Binding SuggestionStatusText}" Classes="dim" FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 在线玩家（图形化管理：踢出/封禁/OP） -->
                    <Border Classes="card" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding PlayersCountText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="刷新" Classes="ghost" Padding="14,5"
                                        Command="{Binding RefreshPlayersCommand}" IsEnabled="{Binding IsRunning}"/>
                            </Grid>
                            <TextBlock Text="暂无玩家在线" Classes="dim" FontSize="12"
                                       IsVisible="{Binding OnlinePlayers.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"/>
                            <ItemsControl ItemsSource="{Binding OnlinePlayers}" IsVisible="{Binding OnlinePlayers.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ServerPlayerVM">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="踢出" Classes="ghost" FontSize="10" Padding="8,2"
                                                    Command="{Binding $parent[Border].((vm:ServerViewModel)DataContext).KickPlayerCommand}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding $parent[Border].((vm:ServerViewModel)DataContext).IsRunning}"/>
                                            <Button Grid.Column="2" Content="封禁" Classes="ghost" FontSize="10" Padding="8,2"
                                                    Command="{Binding $parent[Border].((vm:ServerViewModel)DataContext).BanPlayerCommand}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding $parent[Border].((vm:ServerViewModel)DataContext).IsRunning}"/>
                                            <Button Grid.Column="3" Content="OP" Classes="ghost" FontSize="10" Padding="8,2"
                                                    Command="{Binding $parent[Border].((vm:ServerViewModel)DataContext).OpPlayerCommand}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding $parent[Border].((vm:ServerViewModel)DataContext).IsRunning}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- OP 列表（AI：启动器图形化管理服务器权限——读 ops.json 展示，服务器权限 > 游戏内命令） -->
                    <Border Classes="card" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding OpsCountText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="刷新" Classes="ghost" Padding="14,5"
                                        Command="{Binding RefreshOpsCommand}"/>
                            </Grid>
                            <TextBlock Text="暂无 OP" Classes="dim" FontSize="12"
                                       IsVisible="{Binding OpsList.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"/>
                            <ItemsControl ItemsSource="{Binding OpsList}" IsVisible="{Binding OpsList.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:ServerOpEntry">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="OP" Classes="dim" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="移除" Classes="ghost" FontSize="12" Padding="8,3"
                                                    Command="{Binding $parent[Border].((vm:ServerViewModel)DataContext).RemoveOpCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 封禁列表（AL2：图形化解封——ban 后玩家不在线，必须有独立入口） -->
                    <Border Classes="card" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding BannedCountText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="刷新" Classes="ghost" Padding="14,5"
                                        Command="{Binding RefreshBannedCommand}"/>
                            </Grid>
                            <TextBlock Text="暂无封禁" Classes="dim" FontSize="12"
                                       IsVisible="{Binding BannedList.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"/>
                            <ItemsControl ItemsSource="{Binding BannedList}" IsVisible="{Binding BannedList.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:ServerBannedEntry">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="已封禁" Classes="dim" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="解封" Classes="ghost" FontSize="12" Padding="8,3"
                                                    Command="{Binding $parent[Border].((vm:ServerViewModel)DataContext).UnbanCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- server.properties 图形化（2 列网格，消灭大柱子） -->
                    <Border Classes="card" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="server.properties" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="保存配置" Classes="ghost" Padding="14,5"
                                        Command="{Binding SavePropertiesCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PropRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" RowSpacing="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PropRowVM">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,3">
                                            <TextBlock Text="{Binding Label}" Classes="sub" FontSize="12" MinWidth="88"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding BoolValue}"
                                                          IsVisible="{Binding IsBool}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                      SelectedItem="{Binding Value}" FontSize="12"
                                                      IsVisible="{Binding IsChoice}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                     IsVisible="{Binding IsText}"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding NumberValue}"
                                                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                           FormatString="0" FontSize="12" IsVisible="{Binding IsNumber}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderColor}" ResizeDirection="Columns"/>

            <!-- 右：控制台（占满） -->
            <Border Grid.Column="2" Classes="card" Padding="0" MinWidth="280">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,8"
                            Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="控制台" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="复制" Classes="ghost" FontSize="11" Padding="10,3"
                                    Click="OnCopyLogs"/>
                            <Button Grid.Column="2" Content="导出日志" Classes="ghost" FontSize="11" Padding="10,3"
                                    Click="OnExportLogs"/>
                        </Grid>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="12,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" x:Name="CommandBox" Watermark="输入命令"
                                     KeyDown="OnCommandKeyDown"/>
                            <Button Grid.Column="1" Content="发送" Classes="ghost" Padding="16,6"
                                    Click="OnSendClick" IsEnabled="{Binding IsRunning}"/>
                        </Grid>
                    </StackPanel>
                    <Grid>
                        <ScrollViewer x:Name="LogScroll">
                            <ItemsControl ItemsSource="{Binding Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource TextLog}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="你启动服务端后，日志会显示在这" Foreground="{DynamicResource TextDim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding Logs.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
