<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.App.Views"
        x:Class="Launcher.App.Views.StorageWindow"
        x:DataType="vm:StorageWindow"
        Width="620" SizeToContent="Height" MinHeight="340" MaxHeight="680"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurface}">

    <DockPanel x:Name="Root" Margin="22,18">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="存储空间" FontSize="16" FontWeight="SemiBold"/>
                <Border Classes="help-hint"
                           ToolTip.Tip="红色删除能清：日志、缓存、崩溃报告。开窗时会统计大小，大的要等一会"><Path/></Border>
            </StackPanel>
        </StackPanel>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StorageItemVM">
                        <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="10" Margin="0,3" MinHeight="26">
                            <TextBlock Text="{Binding SizeText}" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                            <Button Grid.Column="2" Content="删除" Classes="danger" FontSize="11" Padding="12,3"
                                    Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
