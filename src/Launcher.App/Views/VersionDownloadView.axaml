<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             x:Class="Launcher.App.Views.VersionDownloadView"
             x:DataType="vm:VersionDownloadViewModel">

    <!-- 8-31 重设计：三栏+翻页 → PCL2 式「顶部搜索+分类chips + 全宽版本行 + 点进全宽详情页」 -->
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="下载游戏" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding Status}" Classes="sub" FontSize="12"/>
        </StackPanel>

        <!-- 8-31 列表层（点行直接弹加载器下载，无详情页跳转） -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <TextBox Text="{Binding Sidebar.SearchText, Mode=TwoWay}" Watermark="搜索版本…" Margin="0,0,0,0"/>

            <!-- 分类 chips（横向一排，选中态高亮） -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Sidebar.Categories}"
                     SelectedItem="{Binding Sidebar.SelectedCategory}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VerticalAlignment="Center">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionCategoryItemVM">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Title}" FontSize="13"/>
                            <TextBlock Text="{Binding Count}" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="14,7"/>
                        <Setter Property="Background" Value="{DynamicResource BgRaised}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource AccentDark}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentLight}"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>

            <!-- 版本列表（全量，无分页；行卡片点行进详情，行内[下载]直下） -->
            <ListBox Grid.Row="2" ItemsSource="{Binding Sidebar.Items}"
                     Opacity="{Binding Sidebar.ListOpacity}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                    </Transitions>
                </ListBox.Transitions>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionListItemVM">
                        <Border Classes="row" Margin="0,1" Padding="14,10" Cursor="Hand" Tapped="OnVersionRowTapped">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1" CornerRadius="3" Padding="6,1" Background="{Binding TypeBadgeBg}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="{Binding TypeBadgeFg}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding ReleaseDate}" Classes="dim" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="3" CornerRadius="3" Padding="6,1" Background="#1E3A2E"
                                        VerticalAlignment="Center" IsVisible="{Binding Installed}">
                                    <TextBlock Text="已装" FontSize="10" Foreground="#5AD07C"/>
                                </Border>
                                <Button Grid.Column="4" Content="下载" Classes="ghost" Padding="14,6" FontSize="12"
                                        Command="{Binding $parent[UserControl].((vm:VersionDownloadViewModel)DataContext).DownloadVersionCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
