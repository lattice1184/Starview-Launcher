<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
    <ProjectReference Include="..\Launcher.App\Launcher.App.csproj" />
    <!-- 单测探针插件：TrialProbe.dll 落到测试输出目录（试运行宿主加载用） -->
    <ProjectReference Include="TestPlugins\TrialProbe\TrialProbe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 探针插件独立工程在测试目录下：排除默认通配，避免 TrialProbe 源码/obj 混进测试程序集（会编两份 AssemblyInfo → CS0579） -->
    <Compile Remove="TestPlugins\**" />
    <None Remove="TestPlugins\**" />
    <Content Remove="TestPlugins\**" />
    <EmbeddedResource Remove="TestPlugins\**" />
    <Page Remove="TestPlugins\**" />
  </ItemGroup>

</Project>
